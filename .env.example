# Backend
ORCA_ALLOW_SIMULATION=false

# Leave CORS_ORIGINS unset for local/demo use: the backend then allows
# localhost plus any private LAN address automatically, which is what lets
# a phone on the same Wi-Fi reach the API (see backend/api/middleware.py).
# Set it explicitly, comma-separated, only for a real deployment, e.g.:
# CORS_ORIGINS=https://orca-frontend.onrender.com

# BHASHINI - keep these only on the backend, never in Vite/frontend env.
# Fill these in your own local .env (never committed) with your approved
# BHASHINI credentials.
BHASHINI_INFERENCE_API_KEY=
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_TRANSLATION_SERVICE_ID=
BHASHINI_LANGUAGE_DETECTION_SERVICE_ID=ai4bharat/indic-lang-detect--gpu-t4
BHASHINI_CONFIG_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_PIPELINE_ID=

# Copernicus Marine
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=

# INCOIS public datasets — no API key required for these endpoints.
INCOIS_ERDDAP_BASE_URL=https://erddap.incois.gov.in/erddap
INCOIS_OCM_DATASET_ID=incois_oceansat2_datasets
INCOIS_PFZ_BULLETIN_URL=https://www.incois.gov.in/MarineFisheries/TextDataHome?mfid=1&request_locale=en
INCOIS_PFZ_WMS_URL=https://incois.gov.in/geoportal/MFASPFZ/index.html

# Local OCM subset is optional; live INCOIS ERDDAP is the default.
OCEAN_AGENT_DATASET_PATH=
OCEAN_AGENT_ALLOW_MOCK=false

# IMD / data.gov.in approved alert endpoint
IMD_ALERTS_URL=

# Optional satellite imagery
NASA_GIBS_BASE_URL=https://gibs.earthdata.nasa.gov/wmts/epsg3857/best
NASA_GIBS_LAYER=MODIS_Aqua_CorrectedReflectance_TrueColor
SENTINEL_HUB_WMS_URL=


# Optional providers / data services
MAPBOX_ACCESS_TOKEN=
WDPA_API_TOKEN=

# Frontend (set in Vercel/Netlify)
VITE_API_BASE_URL=http://localhost:8000

# LLM response layer - backend only. Never expose these in Vite/frontend env.
# xAI/Grok (use an xai-... key):
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_API_URL=https://api.x.ai/v1/chat/completions

# Groq (the supplied gsk_... key is a Groq key):
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
